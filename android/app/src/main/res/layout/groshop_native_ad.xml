<?xml version="1.0" encoding="utf-8"?>
<!--
  Carte pub GROSHOP (native ad) — même gabarit que les cartes produit.
  Ordre : en-tête « Sponsorisé · Annonceur » (attribution EN HAUT, toujours
  visible) → image carrée arrondie → titre 2 lignes → étoiles/prix → bouton.
  L'image prend la hauteur restante : Flutter donne à la cellule
  « largeur + hauteur du texte » (NativeAdTile.heightFor), donc elle est carrée.
  AdChoices : ajouté par le SDK en haut à droite (marge réservée dans l'en-tête).
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- En-tête : logo · « Sponsorisé » · annonceur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:scaleType="centerCrop" />

            <!-- Attribution obligatoire : en premier → jamais coupée -->
            <TextView
                android:id="@+id/ad_attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="15dp"
                android:gravity="center_vertical"
                android:text="Sponsorisé"
                android:textColor="#6B7785"
                android:textSize="12sp" />

            <!-- Annonceur : prend le reste, coupé avec « … » si trop long -->
            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#0F1419"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Image : hauteur restante (≈ carrée), coins arrondis en code -->
        <FrameLayout
            android:id="@+id/ad_media_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F1F2F4">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Titre : toujours 2 lignes réservées (hauteur stable) -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#0F1419"
            android:textSize="14sp" />

        <!-- Étoiles + prix (pubs d'applis) ; invisible si absent -->
        <LinearLayout
            android:id="@+id/ad_rating_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ad_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#9AA3AE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ad_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:textColor="#9AA3AE"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Petit bouton contour orange (texte fourni par Google) -->
        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textAllCaps="false"
            android:textColor="#FF7A00"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>