<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante 1 · PIN — la plus discrète.
  Image (remplit la hauteur dispo) avec badge « Sponsorisé » en haut à gauche,
  puis titre (2 lignes) et annonceur. Pas de bouton.
  AdChoices : ajouté par le SDK en haut à droite (sur l'image).
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/ad_media_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F1F2F4">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Attribution obligatoire : en haut, ≥ 15dp -->
            <TextView
                android:id="@+id/ad_attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:gravity="center_vertical"
                android:minHeight="16dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Sponsorisé"
                android:textColor="#0F1419"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:textColor="#0F1419"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ad_advertiser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6B7785"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>